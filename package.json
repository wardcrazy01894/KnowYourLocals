{
  "name": "knowyourcity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "A daily 'where is it?' map-guessing game for local landmarks — St. Pete, State College, Ann Arbor, Seattle, Chicago.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-pois": "node scripts/fetch-pois.mjs",
    "fetch-food": "node scripts/fetch-food.mjs",
    "build-city": "node scripts/build-city.mjs",
    "check-chains": "node scripts/check-chains.mjs",
    "add-polygons": "node scripts/add-polygons.mjs",
    "pin-day": "node --experimental-strip-types scripts/pin-day.ts",
    "sync-blurbs": "node scripts/sync-blurbs.mjs",
    "gen-blurbs": "node scripts/gen-blurbs-workflow.mjs",
    "apply-blurbs": "node scripts/apply-blurbs.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
